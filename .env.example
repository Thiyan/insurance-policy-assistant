# =========================================================
# APPLICATION CONFIG
# =========================================================

# Path to insurance PDF
PDF_PATH=./resources/Insurance_Handbook_20103.pdf

# ChromaDB persistence directory
DB_PATH=./data/chroma_db

# Chroma collection name
COLLECTION_NAME=rag_collection

# =========================================================
# CHUNKING CONFIG
# =========================================================

CHUNK_SIZE=500
CHUNK_OVERLAP=50
N_RESULTS=3

# =========================================================
# OPENAI / LLM CONFIG
# =========================================================

OPENAI_API_KEY=your_openai_api_key_here

LLM_MODEL=gpt-5.5

EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=1536
EMBED_BATCH_SIZE=100

TEMPERATURE=0

# =========================================================
# VECTOR DB CONFIG
# =========================================================

HNSW_SPACE=cosine

# =========================================================
# INGESTION
# =========================================================

# true -> run ingestion on startup
# false -> skip ingestion and use existing DB
RUN_INGESTION=true

# =========================================================
# LOGGING
# =========================================================

LOG_DIR=./logs

LOG_LEVEL=INFO

LOG_MAX_BYTES=500000000
LOG_BACKUP_COUNT=3

LOG_CONSOLE_OUTPUT=true